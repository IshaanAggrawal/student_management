  "info": {
    "_postman_id": "58af3204-a314-4608-9ba4-e072a4170de4",
    "name": "Student Management API (Exp 3-9)",
    "description": "Requests and automated checks for the Spring Boot Student Management API.\n\nEvery request uses HTTP Basic auth from the `username` / `password` collection variables (default admin / admin123), except the ones that test public or rejected access.\n\nRun the whole collection top-to-bottom with the Collection Runner: earlier requests store generated IDs (studentId, priyaId, raviId, courseId, lifecycleId) that later requests use.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "admin123",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "1",
      "type": "string"
    },
    {
